#### `flow.py`
```python
from crewai import Crew, Process
from crewai.flow.flow import Flow, start, listen
from pydantic import BaseModel
from typing import Optional

from agents import (
    web_researcher_agent,
    sentiment_analyst_agent,
    strategy_manager_agent,
    feature_gap_analyst_agent,
    pricing_analyst_agent
)
from tasks import (
    gather_intelligence_task,
    analyze_sentiment_task,
    audit_features_task,
    audit_pricing_task,
    compile_strategy_task,
    CompetitorResearchPayload,
    StrategicRoadmapPayload
)


class SwarmState(BaseModel):
    target_competitor: str = "Acme Corp"
    research_data: Optional[CompetitorResearchPayload] = None
    strategy_data: Optional[StrategicRoadmapPayload] = None
    approval_status: bool = False


class CompetitorIntelligenceFlow(Flow[SwarmState]):

    @start()
    def initialize_market_sweep(self):
        """Initializes the competitive intelligence flow."""
        print(f"\n=======================================================")
        print(f">>> Initializing Intelligence Flow for: {self.state.target_competitor}")
        print(f"=======================================================\n")

    @listen(initialize_market_sweep)
    def execute_research_crew(self):
        """Runs the sequential research crew and updates flow state."""
        print(">>> Phase 1: Deploying Research Crew (Sequential Process)...")
        research_crew = Crew(
            agents=[web_researcher_agent, sentiment_analyst_agent],
            tasks=[gather_intelligence_task, analyze_sentiment_task],
            process=Process.sequential,
            verbose=True
        )
        output = research_crew.kickoff(inputs={"target_competitor": self.state.target_competitor})
        
        # Save validated Pydantic model to flow state
        self.state.research_data = analyze_sentiment_task.output.pydantic
        print(f"\n>>> Phase 1 Complete. Findings captured for {self.state.target_competitor}.")

    @listen(execute_research_crew)
    def execute_strategic_crew(self):
        """Runs the hierarchical strategy crew and updates flow state."""
        print("\n>>> Phase 2: Deploying Strategy Crew (Hierarchical Process)...")
        strategy_crew = Crew(
            agents=[feature_gap_analyst_agent, pricing_analyst_agent],
            tasks=[audit_features_task, audit_pricing_task, compile_strategy_task],
            process=Process.hierarchical,
            manager_agent=strategy_manager_agent,
            verbose=True
        )
        strategy_crew.kickoff(inputs={"target_competitor": self.state.target_competitor})
        
        # Save validated strategy plan to flow state
        self.state.strategy_data = compile_strategy_task.output.pydantic
        print(f"\n>>> Phase 2 Complete. Strategic roadmap generated.")

    @listen(execute_strategic_crew)
    def executive_review_gate(self):
        """Applies review criteria to validate the proposed strategy."""
        print("\n>>> Phase 3: Reviewing Strategic Recommendations...")
        if self.state.strategy_data and len(self.state.strategy_data.actionable_roadmap_items) > 0:
            self.state.approval_status = True
            print(">>> Strategy Approved: Verified action items present.")
        else:
            self.state.approval_status = False
            print(">>> Strategy Rejected: Missing actionable roadmap items.")

    @listen(executive_review_gate)
    def finalize_intelligence_brief(self):
        """Emits final results and marks the flow complete."""
        print(f"\n================ FINAL DELIVERABLE ================")
        if self.state.strategy_data:
            print(f"Executive Summary:\n{self.state.strategy_data.executive_summary}\n")
            print("Differentiating Factors:")
            for item in self.state.strategy_data.core_differentiation_points:
                print(f" - {item}")
            print(f"\nCounter-Pricing Model:\n{self.state.strategy_data.counter_pricing_strategy}\n")
            print("Actionable Roadmaps:")
            for task in self.state.strategy_data.actionable_roadmap_items:
                print(f" [ ] {task}")
        print("===================================================\n")
        return self.state
