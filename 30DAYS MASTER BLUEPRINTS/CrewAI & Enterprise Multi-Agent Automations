import json
from crewai.tools import BaseTool, tool
from pydantic import BaseModel, Field


class CompetitorSearchInput(BaseModel):
    query: str = Field(..., description="Target search query to execute across business news and industry sources.")


class MockCorporateSearchTool(BaseTool):
    name: str = "Corporate Competitor Intelligence Search"
    description: str = "Searches business wire feeds, financial reports, and product release feeds for competitor actions."
    args_schema: type[BaseModel] = CompetitorSearchInput

    def _run(self, query: str) -> str:
        """Simulate realistic corporate intelligence search results."""
        normalized = query.lower()
        if "pricing" in normalized or "tier" in normalized:
            return json.dumps({
                "source": "SaaS Insights 2026",
                "finding": "Competitor Alpha updated enterprise tiers: $4,500/mo base + usage charges.",
                "confidence": 0.95
            })
        elif "feature" in normalized or "product" in normalized:
            return json.dumps({
                "source": "TechRadar Enterprise",
                "finding": "Competitor Alpha launched native AI orchestration APIs with automated load balancing.",
                "confidence": 0.91
            })
        else:
            return json.dumps({
                "source": "Global Business Wire",
                "finding": "Competitor Alpha reported 28% ARR expansion in enterprise workflow automation solutions.",
                "confidence": 0.88
            })


@tool("Local File Ingestion Tool")
def read_local_brief(file_path: str) -> str:
    """Reads internal strategy notes and baseline briefing files from local disk."""
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            return f.read()
    except Exception as e:
        return f"File read error on path {file_path}: {str(e)}"
